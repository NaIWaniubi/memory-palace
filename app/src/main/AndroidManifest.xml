<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- M14：到期提醒。SCHEDULE_EXACT_ALARM 让闹钟卡在具体时刻；
         Android 12+ 该权限可被用户撤销，代码里有不精确降级路径。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- M-B3：设备重启 / 改时区后重排到期闹钟，否则重启后提醒静默消失（准入「数据/功能连续性」）。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".app.MemoryPalaceApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpatialApp"
        tools:targetApi="35">

        <!-- M12 修订：LAUNCHER 必须直接是 Spatial stub activity。
             SDK 在 LAUNCHER 启动时创建入口容器 —— 用普通 Activity 当 LAUNCHER 会先
             建出默认 WindowContainer，之后 LaunchActivity 注册 Stage 时冲突崩溃；
             而 stage meta-data 挂在普通 LAUNCHER 上则 Stage 根本不注册。
             官方三个 Sample 同样是"LAUNCHER = SpatialLaunchActivity"。
             冷启动黑屏改由 LaunchActivity 启动后换主题解决（见 LaunchActivity.kt），
             manifest 主题保持非透明，系统才能画 starting window。 -->
        <activity
            android:name=".app.LaunchActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|uiMode|keyboardHidden|navigation|keyboard"
            android:theme="@style/Theme.MpSplash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 房间层 Stage 配置（默认容器 = Stage，对齐官方 SpatialAudio Sample） -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="room_stage" />
            <!-- 1: Mixed（MR 混合，虚拟内容 + 真实环境） -->
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="1" />
        </activity>

        <!-- M5 导入：系统文件选择器入口（真机用；模拟器走 card.IMPORT 广播） -->
        <activity
            android:name=".data.ImportPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- M14：闹钟触发后发通知。静态注册：应用进程被杀时系统也要能拉起来。 -->
        <receiver
            android:name=".notify.DueReminder$FireReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.memorypalace.notify.FIRE" />
            </intent-filter>
        </receiver>

        <!-- M-B3：重启 / 解锁 / 改时间 / 改时区后重排待触发的到期闹钟。
             系统闹钟不跨重启，缺这个接收器则重启后提醒静默消失（准入门槛「无数据/功能丢失」）。 -->
        <receiver
            android:name=".notify.DueReminder$ReminderReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
